<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="mb-4 text-center">Adicionar Novo Funcionário</h1>
        <form action="/funcionarios" method="POST">
            <div class="mb-3">
                <label for="nomeUsuario" class="form-label">Nome do Usuário</label>
                <input type="text" class="form-control" id="nomeUsuario" name="nomeUsuario" required>
            </div>
            <div class="mb-3">
                <label for="senha" class="form-label">Senha</label>
                <input type="password" class="form-control" id="senha" name="senha" required>
            </div>
            <div class="mb-3">
                <label for="nomeCompleto" class="form-label">Nome Completo</label>
                <input type="text" class="form-control" id="nomeCompleto" name="nomeCompleto" required>
            </div>
            <div class="mb-3">
                <label for="cargo" class="form-label">Cargo</label>
                <input type="text" class="form-control" id="cargo" name="cargo" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
           
            <div class="mb-3">
                <label for="imagem" class="form-label">Nome da imagem da capa</label>
                <input type="text" class="form-control" id="imagem" name="imagem"
                    placeholder="ex: funcionario_perfil.jpg">
                <div class="form-text">Coloque o arquivo na pasta <code>public/images</code></div>
            </div>
       
            <button type="submit" class="btn btn-primary w-100">Adicionar Funcionário</button>
        </form>
    </div>
</div>