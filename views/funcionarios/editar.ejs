<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h2 class="mb-4">Editar livro</h2>

        <form action="/funcionarios/<%= funcionario.ID %>" method="post">

            <div class="mb-3">
                <label for="Nome" class="form-label">Nome de Usuario</label>
                <input type="text" class="form-control" id="nomeUsuario" value="<%= funcionario.nomeUsuario %>"
                    name="nomeUsuario" required>
            </div>

            <div class="mb-3">
                <label for="Nome" class="form-label">Nome Completo</label>
                <input type="text" class="form-control" id="nomeCompleto" value="<%= funcionario.nomeCompleto %>"
                    name="nomeCompleto" required>
            </div>

            <div class="mb-3">
                <label for="Nome" class="form-label">Cargo</label>
                <input type="text" class="form-control" id="cargo" value="<%= funcionario.cargo %>" name="cargo"
                    required>
            </div>

            <div class="mb-3">
                <label for="Nome" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" value="<%= funcionario.email %>" name="email"
                    required>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                Editar Livro
            </button>
            <a href="/funcionarios" class="btn btn-secondary btn-lg">Cancelar</a>
        </form>
    </div>
</div>