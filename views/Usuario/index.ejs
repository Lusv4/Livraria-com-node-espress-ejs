<% title = "usuarios" %>

<div class="row mb-4">
    <div class="col-12">
        <h1 class="mb-4">Sua conta</h1>
    </div>
</div>

<% if (usuarios.length === 0) { %>

    <div class="alert alert-info text-center" role="alert">
        <p class="mb-3">Voce nao está cadastrado.</p>

        <a href="/usuario/novo" class="btn btn-primary">
            Cadastrar
        </a>
    </div>

<% } else { %>

    <div class="row g-4">

        <% usuarios.forEach(usuario => { %>

            <div class="col-12 col-sm-6 col-lg-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            <%= usuario.Nome %>
                        </h5>

                        <p>
                            <%= usuario.Email %>
                        </p>

                        <p>
                            Telefone: <%= usuario.Telefone %>
                        </p>

                        <a href="/usuario/<%= usuario.ID %>"
                            class="btn btn-sm btn-info">
                            Ver
                        </a>

                        <a href="/usuario/<%= usuario.ID %>/editar"
                            class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        <form action="/usuario/<%= usuario.ID %>/deletar"
                            method="post"
                            class="d-inline"
                            onsubmit="return confirm('Confirmar remover o usuario?')">

                            <button type="submit"
                                class="btn btn-sm btn-danger">
                                Remover
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

<% } %>